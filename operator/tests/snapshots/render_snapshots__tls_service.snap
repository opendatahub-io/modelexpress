---
source: operator/tests/render_snapshots.rs
expression: state.service
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    certs.example.com/secret-name: mx-tls
  labels:
    app.kubernetes.io/instance: mx-tls
    app.kubernetes.io/managed-by: modelexpress-operator
    app.kubernetes.io/name: modelexpress-server
    team: inference
  name: mx-tls
spec:
  ports:
    - name: grpc
      port: 8001
      targetPort: grpc
  selector:
    app.kubernetes.io/instance: mx-tls
    app.kubernetes.io/name: modelexpress-server
