# Images for the TLS e2e on kind (test_tls_kind.sh). Not shipped.
#
# One build stage compiles every binary the e2e deploys, sharing a cargo cache
# across targets:
#   --target operator        modelexpress-operator-openshift, OpenSSL (as shipped)
#   --target server-openssl  modelexpress-server, OpenSSL (as shipped)
#   --target server-rustls   modelexpress-server, default rustls build

FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:bcbf1fe577df63bd975ea19ebae604b5f072e1833b2bde417a0ffd4afd938b96 AS build

RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        rust cargo cmake gcc gcc-c++ perl \
        openssl-devel git-core unzip \
    && dnf clean all

ARG PROTOC_VERSION=35.1
ARG PROTOC_SHA256_X86_64=6930ebf62bd4ea607b98fff052596c6ee564b9835b4ce172c75a3f53ae9d91b7
ARG PROTOC_SHA256_AARCH_64=01bf9d08808c7f96678b63f4bd8efa559bb4f83d5a7a270d5edaf507f9d5d9cf
RUN set -eux; \
    case "$(uname -m)" in \
        x86_64)  PROTOC_ARCH=x86_64;  PROTOC_SHA256="${PROTOC_SHA256_X86_64}"  ;; \
        aarch64) PROTOC_ARCH=aarch_64; PROTOC_SHA256="${PROTOC_SHA256_AARCH_64}" ;; \
        *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip"; \
    echo "${PROTOC_SHA256}  /tmp/protoc.zip" | sha256sum -c -; \
    unzip -q /tmp/protoc.zip -d /usr/local bin/protoc 'include/*'; \
    rm -f /tmp/protoc.zip

WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --release --package modelexpress-operator-openshift --package modelexpress-server \
        --no-default-features --features openssl \
    && cp target/release/modelexpress-operator-openshift /modelexpress-operator \
    && cp target/release/modelexpress-server /modelexpress-server-openssl
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --release --package modelexpress-server \
    && cp target/release/modelexpress-server /modelexpress-server-rustls

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:7c372902c8d211db2d25c8277ba534a73b92742a334874dced829a63b0f21221 AS runtime
RUN microdnf install -y --nodocs ca-certificates openssl-libs \
    && microdnf clean all
USER 65532:65532

FROM runtime AS operator
COPY --from=build --chmod=0555 /modelexpress-operator /usr/local/bin/modelexpress-operator
ENTRYPOINT ["/usr/local/bin/modelexpress-operator"]

FROM runtime AS server-openssl
COPY --from=build --chmod=0555 /modelexpress-server-openssl /usr/local/bin/modelexpress-server
ENTRYPOINT ["/usr/local/bin/modelexpress-server"]

FROM runtime AS server-rustls
COPY --from=build --chmod=0555 /modelexpress-server-rustls /usr/local/bin/modelexpress-server
ENTRYPOINT ["/usr/local/bin/modelexpress-server"]
